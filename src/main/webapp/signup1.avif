normal none running overlayShow; }

@keyframes pulse {=20
  50% { opacity: 0.5; }
}

.animate-pulse { animation: 2s cubic-bezier(0.4, 0, 0.6, 1) 0s infinite nor=
mal none running pulse; }

@keyframes scroll-horizontal {=20
  0% { transform: translateX(0px); }
  100% { transform: translateX(-50%); }
}

.animate-scroll-horizontal { animation: 20s linear 0s infinite normal none =
running scroll-horizontal; }

@keyframes spin {=20
  100% { transform: rotate(1turn); }
}

.animate-spin { animation: 1s linear 0s infinite normal none running spin; =
}

